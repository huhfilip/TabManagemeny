<Window x:Class="TabMan.App.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TabMan settings"
        Width="760"
        Height="560"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Width="100" IsCancel="True" />
      <Button Content="Save" Width="100" Margin="0" IsDefault="True" Click="Save_Click" />
    </StackPanel>
    <TabControl>
      <TabItem Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Appearance" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,4" Foreground="{DynamicResource AppMuted}" Text="Theme" />
            <ComboBox x:Name="ThemeBox" Width="220" HorizontalAlignment="Left" />
            <TextBlock Margin="0,12,0,4" Foreground="{DynamicResource AppMuted}" Text="Sort windows inside a group" />
            <ComboBox x:Name="SortBox" Width="220" HorizontalAlignment="Left" />
            <CheckBox x:Name="ThumbnailsBox" Content="Show live previews in the switcher" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Text="Previews are drawn by Windows for the open switcher only. TabMan never saves thumbnail images." />
            <TextBlock Margin="0,18,0,4" FontWeight="SemiBold" Text="Shortcut" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Text="Click the box and press a shortcut with at least one modifier. Default is Ctrl+Alt+Space." />
            <TextBox x:Name="ShortcutBox" Margin="0,8,0,0" IsReadOnly="True" PreviewKeyDown="ShortcutBox_PreviewKeyDown" />
            <TextBlock x:Name="ShortcutHint" Margin="0,6,0,0" Foreground="{DynamicResource AppMuted}" />
            <TextBlock Margin="0,18,0,4" FontWeight="SemiBold" Text="Keyboard integration" />
            <CheckBox x:Name="StartupBox" Content="Run TabMan when I sign in" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Text="Off by default. This adds or removes a TabMan value in your personal startup list. No administrator permission is required." />
            <CheckBox x:Name="AltTabBox" Content="Also open TabMan for Alt+Tab" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Text="Off by default. When this fails, Windows Alt+Tab is left unchanged. TabMan removes its keyboard hook when you turn this off or exit. It does not change system files." />
            <CheckBox x:Name="HistoryBox" Content="Remember recent applications between launches" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Text="Off by default. Stores application ids and times only. Window titles and file paths are not stored. Turning this off deletes that file." />
            <CheckBox x:Name="DiagnosticsBox" Content="Write diagnostic codes" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Text="Off by default. Writes event codes and counts to diagnostics.log. Window titles are not included." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Projects">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Text="Pick a project, then rename it or choose a color. Colors on an individual window override the project color." />
            <WrapPanel x:Name="Palette" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Add" Click="AddProject_Click" />
              <Button Content="Rename" Click="RenameProject_Click" />
              <Button Content="Move up" Click="MoveProjectUp_Click" />
              <Button Content="Move down" Click="MoveProjectDown_Click" />
              <Button Content="Remove" Click="RemoveProject_Click" />
            </StackPanel>
          </StackPanel>
          <ListBox x:Name="ProjectList" />
        </DockPanel>
      </TabItem>
      <TabItem Header="Rules">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Text="Rules match a reopened window by application and, if you want, a title pattern. * matches any text. ? matches one character. Handles are not stored." />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Process name" />
                <TextBox x:Name="RuleProcess" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Title pattern (optional)" />
                <TextBox x:Name="RuleTitle" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Project" />
                <ComboBox x:Name="RuleProject" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Add rule" Click="AddRule_Click" />
              <Button Content="Remove selected" Click="RemoveRule_Click" />
            </StackPanel>
          </StackPanel>
          <ListBox x:Name="RuleList" />
        </DockPanel>
      </TabItem>
      <TabItem Header="Applications">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Display names" />
            <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Text="Rename how an application appears in the switcher. This does not rename the program itself." />
            <ListBox x:Name="NameList" Height="140" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Rename selected" Click="RenameApp_Click" />
              <Button Content="Clear selected" Click="ClearAppName_Click" />
            </StackPanel>
            <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="Grouping rules" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Text="Put windows into an application group. A title pattern can split one program, for example private browsing windows." />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Process" />
                <TextBox x:Name="GroupProcess" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Group name" />
                <TextBox x:Name="GroupName" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Title pattern (optional)" />
                <TextBox x:Name="GroupTitle" />
              </StackPanel>
            </Grid>
            <Button Margin="0,8,0,8" HorizontalAlignment="Left" Content="Add grouping rule" Click="AddGroupRule_Click" />
            <ListBox x:Name="GroupRuleList" Height="120" />
            <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Remove selected grouping rule" Click="RemoveGroupRule_Click" />
            <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="Open now" />
            <TextBlock Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Text="These are the windows currently open. They are not saved." />
            <ListBox x:Name="LiveList" Height="120" Margin="0,8,0,0" MouseDoubleClick="LiveList_DoubleClick" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Data">
        <StackPanel Margin="12">
          <TextBlock FontWeight="SemiBold" Text="Where TabMan keeps your settings" />
          <TextBox x:Name="DataPathBox" Margin="0,8,0,8" IsReadOnly="True" />
          <TextBlock TextWrapping="Wrap" Text="To remove TabMan completely: exit from the tray icon, delete the folder you launched, then delete the data folder above. If startup was enabled, turn it off here before deleting, or remove the TabMan value from HKCU\Software\Microsoft\Windows\CurrentVersion\Run." />
          <Button Margin="0,16,0,0" HorizontalAlignment="Left" Content="Delete saved settings and history" Click="DeleteData_Click" />
          <TextBlock x:Name="DataStatus" Margin="0,8,0,0" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
